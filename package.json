{
  "name": "dsh-color-task-board",
  "version": "0.1.4",
  "description": "DeepSeek Harness 插件：任务看板，把任务派发到独立会话执行，跟进进度与结果。",
  "type": "module",
  "main": "./src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "files": [
    "src",
    "dist",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "scripts"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "task-board",
    "kanban"
  ],
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "prepublishOnly": "node scripts/build.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shlan28/dsh-task-board.git"
  },
  "homepage": "https://github.com/shlan28/dsh-task-board#readme",
  "bugs": {
    "url": "https://github.com/shlan28/dsh-task-board/issues"
  }
}
